            </p>
          </div>

          <div
            style={{
              marginBottom: "20px"
            }}
          >
            <h4
              style={{
                color: "#06B6D4"
              }}
            >
              Primary Driver
            </h4>

            <p>Flow Rate</p>
          </div>

          <div>
            <h4
              style={{
                color: "#22C55E"
              }}
            >
              Confidence
            </h4>

            <p>91%</p>
          </div>
        </motion.div>
      </div>

      {/* BOTTOM PANELS */}

      <div
        style={{
          display: "grid",
          gridTemplateColumns: "1fr 1fr",
          gap: "25px"
