        >
          <h2
            style={{
              marginBottom: "25px"
            }}
          >
            AI Insights
          </h2>

          <div
            style={{
              marginBottom: "20px"
            }}
          >
            <h4
              style={{
                color: "#8B5CF6"
              }}
