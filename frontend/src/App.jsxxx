    },
    {
      title: "Future Risk",
      value: "92",
      icon: <FaChartLine />,
      color: "#8B5CF6"
    },
    {
      title: "Alert",
      value: "CRITICAL",
      icon: <FaExclamationTriangle />,
      color: "#EF4444"
    },
    {
      title: "Root Cause",
      value: "Flow Rate",
      icon: <FaRobot />,
      color: "#F59E0B"
    }
