  return (
    <div
      style={{
        minHeight: "100vh",
        background:
          "radial-gradient(circle at top,#111827 0%,#050816 45%,#020617 100%)",
        color: "white",
        padding: "40px",
        fontFamily:
          "'Inter', 'Segoe UI', sans-serif"
      }}
    >
      {/* HERO */}

      <div
        style={{
          textAlign: "center",
          marginBottom: "60px"
        }}
      >
        <motion.h1
